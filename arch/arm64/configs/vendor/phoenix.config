# Device
CONFIG_MACH_XIAOMI_PHOENIX=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# IR
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# MMC
CONFIG_MMC=y
# CONFIG_MMC_PERF_PROFILING is not set
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_BLOCK_DEFERRED_RESUME=y
# CONFIG_MMC_TEST is not set
CONFIG_MMC_PARANOID_SD_INIT=y
CONFIG_MMC_CLKGATE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQ_HCI=y
CONFIG_MMC_CQ_HCI_CRYPTO=y
CONFIG_MMC_CQ_HCI_CRYPTO_QTI=y

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# Touchscreen
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Performance and Responsiveness
CONFIG_HZ_1000=y
# CONFIG_HZ_300 is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_BOOST=y
CONFIG_MSM_PERFORMANCE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_QCOM_LLCC_PERFMON=y
CONFIG_LTO=y
CONFIG_THINLTO=y
CONFIG_LTO_CLANG=y

# Memory Management
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_PROCESS_RECLAIM=y

# Filesystem
# CONFIG_F2FS_CHECK_FS is not set

# Networking
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_DEFAULT_TCP_CONG="westwood"

# I/O Scheduler
CONFIG_IOSCHED_BFQ=y

# Power Management
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Disable Unnecessary Debugging (Performance)
# CONFIG_SLUB_DEBUG is not set
# CONFIG_PANIC_ON_REBOOT is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_STACKTRACE is not set
# CONFIG_DEBUG_MISC is not set
